<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.meduna.controller.EstadisticaController"
            prefWidth="900" prefHeight="600">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta"/>

                <Label text="Médico:"/>
                <ComboBox fx:id="cbMedico" prefWidth="220"/>

                <Label text="Especialidad:"/>
                <ComboBox fx:id="cbEspecialidad" prefWidth="220"/>

                <Button text="Aplicar" onAction="#onActionAplicar"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Reporte:"/>
                <ComboBox fx:id="cbReporte" prefWidth="320"/>
            </HBox>

            <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="8">
                        <Label fx:id="lblTituloTabla" text="Resultados"/>
                        <TableView fx:id="tbvStats" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="260"/>
                                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="8">
                        <Label fx:id="lblTituloChart" text="Gráfico"/>
                        <StackPane fx:id="chartContainer" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </items>
            </SplitPane>

        </VBox>
    </children>
</AnchorPane>
