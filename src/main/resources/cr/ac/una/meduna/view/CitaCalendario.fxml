<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cr.ac.una.meduna.controller.CitaCalendarioController"
            prefWidth="900" prefHeight="650">

    <children>
        <VBox spacing="12" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10"
              AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

            <!-- Header Mes -->
            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #1f1f1f; -fx-background-radius: 8; -fx-padding: 10;">
                <Button fx:id="btnPrev" text="◀" onAction="#onActionPrevMes" />
                <Label fx:id="lblMes" text="ENERO 2026" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                <Button fx:id="btnNext" text="▶" onAction="#onActionNextMes" />
            </HBox>

            <!-- Encabezado días -->
            <GridPane hgap="5" vgap="5">
                <columnConstraints>
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                </columnConstraints>

                <Label text="Dom" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                <Label text="Lun" GridPane.columnIndex="1" style="-fx-font-weight: bold;" />
                <Label text="Mar" GridPane.columnIndex="2" style="-fx-font-weight: bold;" />
                <Label text="Mié" GridPane.columnIndex="3" style="-fx-font-weight: bold;" />
                <Label text="Jue" GridPane.columnIndex="4" style="-fx-font-weight: bold;" />
                <Label text="Vie" GridPane.columnIndex="5" style="-fx-font-weight: bold;" />
                <Label text="Sáb" GridPane.columnIndex="6" style="-fx-font-weight: bold;" />
            </GridPane>

            <!-- Calendario -->
            <GridPane fx:id="gridCalendario" hgap="5" vgap="5" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #f4f4f4; -fx-padding: 8; -fx-background-radius: 8;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                    <ColumnConstraints percentWidth="14.285" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="16.666" />
                    <RowConstraints percentHeight="16.666" />
                    <RowConstraints percentHeight="16.666" />
                    <RowConstraints percentHeight="16.666" />
                    <RowConstraints percentHeight="16.666" />
                    <RowConstraints percentHeight="16.666" />
                </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Fecha seleccionada:" style="-fx-font-weight: bold;" />
                <Label fx:id="lblFechaSeleccionada" text="-" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cerrar" onAction="#onActionCerrar"/>
            </HBox>

            <!-- Tabla del día -->
            <VBox spacing="6">
                <Label text="Citas del Día:" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <TableView fx:id="tbvCitasDia" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="360"/>
                        <TableColumn fx:id="colHoraIni" text="Hora Inicio" prefWidth="140"/>
                        <TableColumn fx:id="colHoraFin" text="Hora Final" prefWidth="140"/>
                        <TableColumn fx:id="colAccion" text="Acción" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </children>
</AnchorPane>
